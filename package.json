{
  "name": "archivecore",
  "version": "1.0.0",
  "private": true,
  "description": "ArchiveCore - Multi-tenant Archive Management System",
  "license": "MIT",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "build:shared": "npm run build --workspace=shared",
    "build:client": "npm run build --workspace=client",
    "typecheck": "npm run typecheck --workspace=shared && npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "db:migrate": "npx prisma migrate deploy",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:check-integrity": "node server/scripts/check-data-integrity.cjs",
    "db:audit-box-loans": "node server/scripts/audit-box-loan-status.cjs",
    "db:audit-billing-amounts": "node server/scripts/audit-billing-amounts.cjs",
    "test:billing-export": "node --test server/scripts/test-billing-export.cjs",
    "test:billing-invoice": "node --test server/scripts/test-billing-invoice.cjs",
    "test:billing-repricing": "node --import tsx --test server/scripts/test-billing-repricing.cjs",
    "test:billing-close": "node --import tsx --test server/scripts/test-billing-close.cjs",
    "test:billing-amount-audit": "node --test server/scripts/test-audit-billing-amounts.cjs",
    "test:qr": "node --import tsx --test server/scripts/test-qr.mjs",
    "test:order-picking": "node --import tsx --test server/scripts/test-order-picking.mjs",
    "test:loan-return": "node --import tsx --test server/scripts/test-loan-return.mjs",
    "test:box-loan-audit": "node --test server/scripts/test-audit-box-loan-status.cjs",
    "test:inventory": "node --import tsx --test server/scripts/test-inventory.mjs",
    "test:inventory-sessions": "node --import tsx --test server/scripts/test-inventory-sessions.mjs",
    "test:warehouse-receive": "node --import tsx --test server/scripts/test-warehouse-receive.mjs",
    "test:box-movement": "node --import tsx --test server/scripts/test-box-movement.mjs",
    "test:warehouse-home": "node --import tsx --test server/scripts/test-warehouse-home.mjs",
    "test:monthly-report": "node --import tsx --test server/scripts/test-monthly-report.cjs",
    "test:transfer-list-mapping": "node --import tsx --test server/scripts/test-transfer-list-mapping.cjs",
    "test:table-import-mapping": "node --import tsx --test server/scripts/test-table-import-mapping.cjs",
    "test:scan-import": "node --import tsx --test server/scripts/test-scan-import.cjs",
    "test:offline-shell": "node --test client/scripts/test-offline-shell.cjs",
    "test:order-draft": "node --import tsx --test client/scripts/test-order-draft.mjs",
    "test:order-requester-access": "node --import tsx --test server/scripts/test-order-requester-access.mjs",
    "test:offline-warehouse-scans": "node --import tsx --test client/scripts/test-offline-warehouse-scans.mjs",
    "test:warehouse-submission": "node --import tsx --test client/scripts/test-warehouse-submission.mjs",
    "test:warehouse-idempotency": "node --import tsx --test server/scripts/test-warehouse-idempotency.mjs",
    "test:legal-hold": "node --import tsx --test server/scripts/test-legal-hold.mjs",
    "test:disposal-evidence": "node --test server/scripts/test-disposal-evidence.mjs",
    "test:order-handover-photos": "node --test server/scripts/test-order-handover-photos.mjs",
    "test:order-scans": "node --import tsx --test server/scripts/test-order-scans.mjs",
    "test:location-capacity": "node --import tsx --test server/scripts/test-location-capacity.mjs",
    "test:storage-health": "node --import tsx --test server/scripts/test-storage-health.mjs",
    "test:integrations": "node --import tsx --test server/scripts/test-integrations.mjs",
    "test:webhooks": "node --import tsx --test server/scripts/test-webhooks.mjs",
    "test:hr-retention": "node --import tsx --test server/scripts/test-hr-retention.mjs",
    "db:seed": "npx prisma db seed",
    "db:reset": "npx prisma migrate reset",
    "db:studio": "npx prisma studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup": "npm install && npm run docker:up && sleep 5 && npm run db:migrate:dev && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
